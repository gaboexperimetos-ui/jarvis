#!/usr/bin/env bash
set -euo pipefail

if ! systemctl --user is-active --quiet jarvis-voice.service; then
    systemctl --user start jarvis-voice.service
    for _ in $(seq 1 20); do
        systemctl --user is-active --quiet jarvis-voice.service && break
        sleep 0.1
    done
fi

systemctl --user kill --kill-who=main -s SIGUSR1 jarvis-voice.service
