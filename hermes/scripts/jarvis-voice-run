#!/usr/bin/env bash
set -euo pipefail

export HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"

PY=""
for cand in "$HERMES_HOME"/installs/*/environments/*/venv/bin/python; do
    [ -x "$cand" ] || continue
    if "$cand" -c 'import sherpa_onnx, sounddevice, faster_whisper, edge_tts, vosk' >/dev/null 2>&1; then
        PY="$cand"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "jarvis-voice: no encuentro un Python con las dependencias de voz" >&2
    exit 1
fi

exec "$PY" "$HERMES_HOME/scripts/jarvis-voice.py" "$@"
