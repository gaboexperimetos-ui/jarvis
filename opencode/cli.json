{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "image_preview": true,
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "permissions": "autoaccept",
    "submit_scroll": "bottom"
  },
  "plugins": [
    {
      "package": "/home/gabo/.config/opencode/plugins/loop",
      "options": {
        "judge": {
          "providerID": "local",
          "id": "deepseek-v4pro"
        },
        "maxTurns": 500,
        "stallTurns": 8,
        "maxStallNudges": 10,
        "maxRetries": 200,
        "retryBaseMs": 20000,
        "retryMaxMs": 600000
      }
    }
  ],
  "debug": {
    "devtools": true
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": true
  },
  "prompt": {
    "image_preview": true
  }
}
