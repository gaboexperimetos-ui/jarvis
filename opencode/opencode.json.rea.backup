{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/dots-studio/dots-3-note-preview:free",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "genoffice": {
      "type": "local",
      "command": [
        "/opt/GenOffice/resources/cli/genoffice",
        "mcp"
      ],
      "enabled": true
    },
    "servers": {
      "mikareno": {
        "type": "remote",
        "url": "http://127.0.0.1:8080/mcp"
      },
      "shopify": {
        "type": "remote",
        "url": "https://gruposalas.myshopify.com/api/mcp"
      },
      "rea": {
        "type": "local",
        "command": [
          "rea",
          "mcp"
        ]
      }
    },
    "claude-mem": {
      "type": "local",
      "command": [
        "/usr/bin/node",
        "/home/gabo/.claude/plugins/marketplaces/thedotmack/plugin/scripts/mcp-server.cjs"
      ]
    }
  },
  "compaction": {
    "auto": true
  },
  "small_model": "odysseus/spark-x2.6-4b",
  "providers": {
    "odysseus": {
      "name": "Odysseus (local router 8004)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8004/v1",
        "apiKey": "local"
      },
      "models": {
        "lfm2.5-8b": {
          "name": "LFM2.5-8B-A1B MoE (agente con tools, rápido)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "spark-x2.6-4b": {
          "name": "Spark-X2.6-4B abliterated (diálogos)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },
    "freellmapi": {
      "name": "FreeLLMAPI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:FREELLMAPI_API_KEY}"
      },
      "models": {
        "auto": {
          "name": "Auto (router picks the best available model)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "fusion": {
          "name": "Fusion (panel of models answer in parallel, a judge synthesizes one answer)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "Laguna S 2.1 (free)",
          "family": "laguna",
          "releaseDate": "2026-07-21",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "poolside/laguna-xs-2.1:free": {
          "name": "Laguna XS 2.1 (free)",
          "family": "laguna",
          "releaseDate": "2026-07-02",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "dots-studio/dots-3-note-preview:free": {
          "name": "Dots3-Note Preview (free)",
          "releaseDate": "2026-08-14",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          },
          "limit": {
            "context": 512000,
            "output": 460800
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        },
        "openrouter/free": {
          "name": "OpenRouter Free (router entre modelos gratis)",
          "releaseDate": "2026-02-01",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 200000,
            "output": 8000
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  }
}